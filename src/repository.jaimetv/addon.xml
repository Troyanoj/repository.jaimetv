<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.jaimetv" name="Repositorio Jaimetv" version="1.0.0" provider-name="Troyanoj">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Repositorio Jaimetv">
    <dir minversion="21.3.0">
      <info compressed="false">{{BASE_URL}}/addons.xml</info>
      <checksum>{{BASE_URL}}/addons.xml.md5</checksum>
      <datadir zip="true">{{BASE_URL}}/zips</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>Repositorio propio de Palantir 3</summary>
    <description>Repositorio auto-hospedado para distribuir las actualizaciones de Palantir 3 y sus addons asociados.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
